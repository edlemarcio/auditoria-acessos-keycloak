{
  "name": "kc-auditor-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:dubles": "VITE_DUBLES=1 vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:aceite": "playwright test -c playwright.aceite.config.ts",
    "e2e:real": "playwright test -c playwright.real.config.ts",
    "capturas": "CAPTURAS=1 playwright test capturas",
    "e2e:build": "npm run build && playwright test -c playwright.build.config.ts"
  },
  "dependencies": {
    "@fontsource/raleway": "^5.3.0",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@govbr-ds/core": "^3.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^22.20.7",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^26.1.0",
    "msw": "^2.15.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^7.3.8",
    "vitest": "^3.2.7"
  }
}
